# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Required. Clients must send this in the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional: a real language model. With these unset the app runs in offline echo mode.
# Option 1: Claude through the official SDK (pip install -e ".[anthropic]").
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=            # from your Anthropic console. Set a monthly spend limit there first.
#   LLM_MODEL=                    # the Claude model id you chose
#   LLM_EFFORT=low                # low|medium|high|xhigh|max, or none for a model without effort
#   LLM_MAX_TOKENS=1024
#   Optional, one model per job (they override LLM_MODEL for that job only):
#   EXTRACTOR_LLM_MODEL=          # fact extraction: a small, cheap model is usually enough
#   REPLY_LLM_MODEL=              # chat replies
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Option 2: any OpenAI-style server.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_EFFORT=low

# Which fact extractor /chat uses: "rules" (offline, simple sentences) or "llm" (needs a real model above).
EXTRACTOR=rules

# Calls to /chat per client address per minute (0 disables). Per-process only.
RATE_LIMIT_PER_MINUTE=30

# Optional: "hash" (offline baseline) or "fastembed" (needs the [local] extra and a model download).
EMBEDDER=hash

# Only for a hosted Qdrant instead of the compose one:
# QDRANT_URL=https://your-cluster.example.com:6333
# QDRANT_API_KEY=
